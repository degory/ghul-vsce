{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "outDir": "./dist",
        "noEmit": false,
        "isolatedModules": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "lib": [
        "es2020"
    ]
}
