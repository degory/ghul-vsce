{
	"compilerOptions": {
		"strict": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,		
		"target": "es6",
		"module": "node16",
		"moduleResolution": "node16",
		"skipLibCheck": true,
		"sourceMap": true,
		"lib" : [ "ES2020" ],
		"outDir": "../client/server"
	},
	"exclude": [
		"node_modules",
		"tests"
	],
	"lib": [
		"es2020"
	],
}