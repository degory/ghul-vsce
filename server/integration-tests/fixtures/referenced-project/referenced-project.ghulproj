<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="src/**/*.ghul" />

    <!-- The point of this fixture: a referenced project whose output assembly
         does not exist until something builds it, which is what a fresh clone
         or a new Codespace looks like. -->
    <ProjectReference Include="lib/lib.ghulproj" />

    <!-- See simple-project: the target that resolves the analyser's -a flags
         comes from ghul.runtime's build/ folder, which a real repo picks up
         through its shared props.

         Pinned new enough to have GenerateGhulResponseFile, so this fixture
         covers the response-file path end to end while simple-project, which
         stays on an old runtime, covers the fallback to the JSON targets. -->
    <PackageReference Include="ghul.runtime" Version="14.3.0" />
  </ItemGroup>
</Project>
