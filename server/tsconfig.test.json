{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "lib": [
        "es2020"
    ]
}
