{
  "name": "ghul",
  "displayName": "ghūl",
  "description": "ghūl language support",
  "version": "0.9.0-json-protocol-alpha.3",
  "publisher": "degory",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/degory/ghul-vsce.git"
  },
  "icon": "images/ghul-logo-icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ghul"
  ],
  "main": "./client/out/extension",
  "contributes": {
    "languages": [
      {
        "id": "ghul",
        "aliases": [
          "ghul",
          "ghūl"
        ],
        "extensions": [
          ".ghul"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ghul",
        "scopeName": "source.ghul",
        "path": "./syntaxes/ghul.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "markup.inserted.narrowing-taken.ghul",
            "settings": {
              "foreground": "#3FB950"
            }
          },
          {
            "scope": "markup.deleted.narrowing-else.ghul",
            "settings": {
              "foreground": "#F85149"
            }
          }
        ]
      }
    },
    "semanticTokenScopes": [
      {
        "language": "ghul",
        "scopes": {
          "modifier": [
            "storage.modifier.ghul"
          ]
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "ghūl",
        "owner": "ghul",
        "fileLocation": [
          "absolute"
        ],
        "pattern": [
          {
            "regexp": "^/(.*):\\s+(\\d+),(\\d+)\\.\\.(\\d+),(\\d+):\\s+(info|warn|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "endLine": 4,
            "endColumn": 5,
            "severity": 6,
            "message": 7
          }
        ]
      },
      {
        "name": "ghūl",
        "owner": "ghul",
        "fileLocation": [
          "relative",
          "${workspaceRoot}"
        ],
        "pattern": [
          {
            "regexp": "^(.*):\\s+(\\d+),(\\d+)\\.\\.(\\d+),(\\d+):\\s+(info|warn|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "endLine": 4,
            "endColumn": 5,
            "severity": 6,
            "message": 7
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run webpack",
    "webpack": "npm run genversion && npm run clean && webpack --mode production --config ./client/webpack.config.js && webpack --mode production --config ./server/webpack.config.js",
    "webpack:dev": "npm run genversion && npm run clean && webpack --mode none --config ./client/webpack.config.js && webpack --mode none --config ./server/webpack.config.js",
    "package:language-server": "node ./language-server/build.js && cd language-server && npm pack --pack-destination ..",
    "compile": "tsc -b",
    "compile:client": "tsc -b ./client/tsconfig.json",
    "compile:server": "tsc -b ./server/tsconfig.json",
    "genversion": "genversion ./client/src/version.js && genversion ./server/src/version.js",
    "watch": "tsc -b -w",
    "clean": "rimraf client/out && rimraf server/out && rimraf language-server/out",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "test": "npm run genversion && npm run test:client && npm run test:server",
    "test:client": "cd client && npm test",
    "test:server": "cd server && npm run typecheck && npx jest"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@vscode/vsce": "^3.9.1",
    "genversion": "^3.2.0",
    "merge-options": "^3.0.4",
    "ovsx": "^0.10.12",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "throttle-debounce": "^5.0.2"
  }
}
