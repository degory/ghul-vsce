{
	"compilerOptions": {
		"strict": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,		
		"target": "es6",
		"module": "node16",
		"moduleResolution": "node16",
		"skipLibCheck": true,
		"rootDir": ".",
		"outDir": "out",
		"lib": [ "es5" ],
		"sourceMap": true
	},
	"exclude": [
		"node_modules",
		"server"
	]
}